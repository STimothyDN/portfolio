# Public CDN base URL for the Bunny.net Pull Zone serving photography images.
# Used by the Astro site at build time.
PUBLIC_BUNNY_CDN_URL=https://<pull-zone>.b-cdn.net

# Bunny.net Storage credentials, used only by scripts/upload-shoot.mjs.
# Find these in the Bunny dashboard under your Storage Zone's FTP & API Access tab.
# BUNNY_STORAGE_ACCESS_KEY is the storage zone password, NOT your account API key.
BUNNY_STORAGE_ZONE=<storage-zone-name>
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=<storage-zone-password>

# ---------------------------------------------------------------------------
# Film Lab (/photography/lab). See src/lib/lab/README.md.
# Local development needs none of these: it uses a SQLite file in .data/ and
# the setup code `film-lab-dev`. Set them in Vercel (Production) for timo3.dev,
# and keep production database credentials in .env.production (gitignored) for
# `npm run db:migrate:prod`, not here.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso database token>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# BETTER_AUTH_URL=https://timo3.dev
# FILM_LAB_SETUP_TOKEN=<openssl rand -base64 24>
