# Public CDN base URL for the Bunny.net Pull Zone serving photography images.
# Used by the Astro site at build time.
PUBLIC_BUNNY_CDN_URL=https://<pull-zone>.b-cdn.net

# Bunny.net Storage credentials, used only by scripts/upload-shoot.mjs.
# Find these in the Bunny dashboard under your Storage Zone's FTP & API Access tab.
# BUNNY_STORAGE_ACCESS_KEY is the storage zone password, NOT your account API key.
BUNNY_STORAGE_ZONE=<storage-zone-name>
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=<storage-zone-password>

# ---------------------------------------------------------------------------
# Film Lab (/photography/lab). See src/lib/lab/README.md.
# Set them in Vercel (Production) for timo3.dev. Locally they're only read by
# `npm run db:migrate:prod` (from .env.production, or from .env): `npm run dev`
# ignores them and uses a SQLite file in .data/ with the setup code `film-lab-dev`.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso database token>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# BETTER_AUTH_URL=https://timo3.dev
# FILM_LAB_SETUP_TOKEN=<openssl rand -base64 24>
# Vercel deploy hook behind "Publish to portfolio" (Project → Settings → Git →
# Deploy Hooks). Production only; keep it secret.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/<project>/<hook>
#
# Live tracking status for mailed rolls (17TRACK API key; production only).
# TRACKING_17TRACK_KEY=<17token from api.17track.net>
#
# Optional:
# FILM_LAB_DEV_TRACKING=1   let `npm run dev` use TRACKING_17TRACK_KEY (spends tracking numbers)
#
# The film desk comes from Film Labs (the film-labs repo, lab.timo3.dev), which
# owns it; scans are ingested there. Where to read it (default production, which
# is public and read-only; point it at a local Film Labs to try changes):
# FILM_LAB_API_URL=https://lab.timo3.dev/api
