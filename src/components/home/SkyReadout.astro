---
/**
 * Observatory readout strip: the live sky over Research Triangle Park,
 * computed in the browser with the same astronomy the sky canvas draws from
 * (src/scripts/sky/astro.ts). Server-renders placeholders; the script fills them.
 */
const LAT = 35.9;
const LON = -78.86;
---

<dl class="readout" data-readout data-lat={LAT} data-lon={LON}>
	<div class="item live">
		<dt class="sr-only">Status</dt>
		<dd>
			<button type="button" class="live-btn" data-telemetry-toggle aria-pressed="false" aria-controls="telemetry">
				<span class="pulse" aria-hidden="true"></span>Live sky<span class="sr-only">: show telemetry</span>
			</button>
		</dd>
	</div>
	<div class="item">
		<dt>Obs</dt>
		<dd>35.90°N 78.86°W</dd>
	</div>
	<div class="item">
		<dt>Local</dt>
		<dd><time data-clock>--:--:--</time> <span data-tz>ET</span></dd>
	</div>
	<div class="item optional">
		<dt>LST</dt>
		<dd data-lst>--h --m</dd>
	</div>
	<div class="item">
		<dt>Sun</dt>
		<dd data-sun>--°</dd>
	</div>
	<div class="item">
		<dt>Moon</dt>
		<dd data-moon>--</dd>
	</div>
	<div class="item optional">
		<dt>Shower</dt>
		<dd data-shower>--</dd>
	</div>
	<div class="item tilt" data-tilt-item hidden>
		<dt class="sr-only">Tilt parallax</dt>
		<dd><button type="button" class="live-btn" data-tilt aria-pressed="false">Tilt: off</button></dd>
	</div>
</dl>

<script>
	import { enableSkyTilt, skyTiltNeedsPermission, skyTilting } from '../../scripts/sky';
	import { DEG, altitudeDeg, julian, lstHours, moonPhase, sun, toHorizon } from '../../scripts/sky/astro';
	import { showerStatus } from '../../scripts/sky/showers';

	const clockFormat = new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/New_York',
		hour: '2-digit',
		minute: '2-digit',
		second: '2-digit',
		hourCycle: 'h23',
		timeZoneName: 'short',
	});

	let timer = 0;

	function start() {
		clearInterval(timer);
		const root = document.querySelector<HTMLElement>('[data-readout]');
		if (!root) return;
		const lat = Number(root.dataset.lat);
		const lon = Number(root.dataset.lon);
		const el = (sel: string) => root.querySelector<HTMLElement>(sel)!;
		const [clock, tz, lstEl, sunEl, moonEl, showerEl] = [
			'[data-clock]',
			'[data-tz]',
			'[data-lst]',
			'[data-sun]',
			'[data-moon]',
			'[data-shower]',
		].map(el);

		const shower = showerStatus();
		showerEl.textContent = shower.active
			? `${shower.name} · ${shower.strength > 0.85 ? 'peak' : 'active'}`
			: `${shower.name} in ${shower.days}d`;

		// iOS only offers tilt behind a permission prompt, which needs a tap.
		const tiltItem = root.querySelector<HTMLElement>('[data-tilt-item]')!;
		const tiltBtn = root.querySelector<HTMLButtonElement>('[data-tilt]')!;
		const tiltState = (on: boolean) => {
			tiltBtn.textContent = `Tilt: ${on ? 'on' : 'off'}`;
			tiltBtn.setAttribute('aria-pressed', String(on));
		};
		if (skyTiltNeedsPermission() && matchMedia('(pointer: coarse)').matches) {
			tiltItem.hidden = false;
			tiltState(skyTilting());
			tiltBtn.onclick = async () => tiltState(await enableSkyTilt());
		}

		const tick = () => {
			const now = new Date();
			const jd = julian(now.getTime());
			const parts = clockFormat.formatToParts(now);
			const part = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
			clock.textContent = `${part('hour')}:${part('minute')}:${part('second')}`;
			tz.textContent = part('timeZoneName');
			const t = lstHours(jd, lon);
			lstEl.textContent = `${String(Math.floor(t)).padStart(2, '0')}h ${String(Math.floor((t % 1) * 60)).padStart(2, '0')}m`;
			const s = sun(jd);
			const alt = altitudeDeg(toHorizon(s.ra, s.dec, t * 15 * DEG, lat * DEG));
			sunEl.textContent = `${alt >= 0 ? '+' : '−'}${Math.abs(alt).toFixed(1)}°`;
			const m = moonPhase(jd);
			moonEl.textContent = `${m.name} ${Math.round(m.illumination * 100)}%`;
		};
		tick();
		timer = window.setInterval(tick, 1000);
	}

	document.addEventListener('astro:page-load', start);
	document.addEventListener('astro:before-swap', () => clearInterval(timer));
</script>

<style>
	.readout {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 1.25rem;
		margin: 0;
		padding-block: 0.625rem;
		/* Hairlines from the ink colour: visible on both the night and the
		   (very light) day sky, where --gray-800 all but vanishes. */
		border-block: 1px solid color-mix(in oklch, var(--gray-0) 14%, transparent);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--gray-400);
	}

	.item {
		display: flex;
		gap: 0.5em;
		white-space: nowrap;
	}

	.item[hidden] {
		display: none;
	}

	dd {
		margin: 0;
		color: var(--gray-200);
	}

	.live-btn {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin: -0.25em -0.4em;
		padding: 0.25em 0.4em;
		border: 0;
		border-radius: 0.25rem;
		background: none;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		color: var(--link-color);
		cursor: pointer;
	}

	.live-btn:hover,
	.live-btn[aria-pressed='true'] {
		background: var(--accent-subtle-overlay);
	}

	.live-btn:focus-visible {
		outline: 2px solid var(--link-color);
		outline-offset: 1px;
	}

	.pulse {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: currentColor;
		box-shadow: 0 0 0 0 currentColor;
	}

	@media (prefers-reduced-motion: no-preference) {
		.pulse {
			animation: readout-pulse 2.4s ease-out infinite;
		}
	}

	@keyframes readout-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in oklch, currentColor 60%, transparent);
		}
		70%,
		100% {
			box-shadow: 0 0 0 0.6em transparent;
		}
	}

	/* Phones: two tidy rows; sidereal time is the first thing to go. */
	@media (max-width: 49.99em) {
		.optional {
			display: none;
		}
	}

	@media (min-width: 50em) {
		.readout {
			justify-content: space-between;
			font-size: 0.75rem;
		}
	}
</style>
