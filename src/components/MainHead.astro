---
import '../styles/app.css';

// Self-hosted variable fonts (font-display: swap; downloads only when a
// palette actually uses the face). Space theme: Bricolage Grotesque (display,
// opsz axis) + Instrument Sans (body). Editorial: Fraunces + Newsreader.
// Only the italic Fraunces mastheads use the SOFT/WONK axes, so the upright
// face ships the wght+opsz cut — pixel-identical for every upright use and
// ~45% lighter than the full-axes file.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';

// Hashed URLs for preloading the above-the-fold faces per route.
import bricolageUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import instrumentUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-italic.woff2?url';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	noindex?: boolean;
}

const {
	title = 'Timothy Navarro',
	description = 'The personal portfolio of Timothy Navarro',
	noindex = false,
} = Astro.props;

// Same section computation as BaseLayout: the editorial faces are only
// above-the-fold inside /photography. There, the film desk and the digital
// index lead with upright Fraunces (nav, mastheads, canister labels); a shoot
// page's masthead is the italic cut.
const path = Astro.url.pathname;
const isPhotography = path === '/photography' || path.startsWith('/photography/');
const isShootPage = /^\/photography\/digital\/[^/]+\/?$/.test(path);
const preloadFonts = !isPhotography
	? [bricolageUrl, instrumentUrl]
	: [isShootPage ? frauncesItalicUrl : frauncesUrl, newsreaderUrl];
const cdnOrigin = import.meta.env.PUBLIC_BUNNY_CDN_URL;
---

<meta charset="UTF-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
{/* Every photography image comes off the Bunny pull zone; warm the
    connection before the first <img> or client-built URL asks for it. */}
{cdnOrigin && (isPhotography ? <link rel="preconnect" href={cdnOrigin} /> : <link rel="dns-prefetch" href={cdnOrigin} />)}

<ClientRouter />

<script is:inline>
	// Inlined in the head so the theme is set before the first paint.
	//
	// The default, site-wide — and nothing is ever stored:
	// 1. a dark browser or device setting (prefers-color-scheme) → dark;
	// 2. otherwise the Sun over Durham/RTP: light while it's up, dark from
	//    sunset to sunrise (?at=<ISO time> previews any moment).
	// Browsers report "light" when nothing is set, so light and unset both
	// fall through to the Sun. A toggle (ThemeToggle.astro) holds for the rest
	// of the visit, across client-side navigations; a reload or a revisit
	// returns to the default. Until then, the page follows the default live:
	// the device switching modes, or the Sun rising or setting.
	(() => {
		const SITE = { lat: 35.9, lon: -78.86 };
		const darkDevice = window.matchMedia('(prefers-color-scheme: dark)');

		// The Sun's altitude over the site, degrees: a compact solar position,
		// within about a minute of the sky readout's sunrise and sunset.
		const sunAltitude = (ms) => {
			const rad = Math.PI / 180;
			const d = ms / 864e5 - 10957.5; // days from J2000.0
			const g = (357.529 + 0.98560028 * d) * rad;
			const L = (280.459 + 0.98564736 * d + 1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * rad;
			const e = (23.439 - 3.6e-7 * d) * rad;
			const ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L));
			const dec = Math.asin(Math.sin(e) * Math.sin(L));
			const ha = (280.46061837 + 360.98564736629 * d + SITE.lon) * rad - ra;
			const lat = SITE.lat * rad;
			return Math.asin(Math.sin(lat) * Math.sin(dec) + Math.cos(lat) * Math.cos(dec) * Math.cos(ha)) / rad;
		};

		// A preview's clock runs on from its ?at= moment, as the sky's does.
		const previewOffsets = {};
		const skyTime = (search) => {
			const at = new URLSearchParams(search).get('at');
			const target = at ? Date.parse(at) : NaN;
			if (!Number.isFinite(target)) return Date.now();
			previewOffsets[at] ??= target - Date.now();
			return Date.now() + previewOffsets[at];
		};

		const defaultDark = (search = location.search) =>
			// Below the horizon: allowing for refraction and the Sun's radius.
			darkDevice.matches || sunAltitude(skyTime(search)) <= -0.833;

		const applyTheme = (root = document.documentElement, search = location.search) => {
			const chosen = window.__themeOverride;
			root.classList.toggle('theme-dark', chosen ? chosen === 'dark' : defaultDark(search));
		};
		applyTheme();

		// Choices used to be saved per section; they no longer count, so clear them.
		try {
			localStorage.removeItem('theme');
			localStorage.removeItem('theme-photography');
		} catch {
			/* storage unavailable: nothing to clear */
		}

		// Registered once per visit (the router keeps this script).
		if (window.__themeObserver) return;
		window.__themeObserver = true;
		// ClientRouter swaps the <html> attributes on navigation, which would
		// drop `theme-dark`: stamp it onto the incoming document, then re-assert.
		document.addEventListener('astro:before-swap', (e) => {
			if (e.newDocument) applyTheme(e.newDocument.documentElement, e.to?.search);
		});
		document.addEventListener('astro:after-swap', () => applyTheme());

		// Follow the default while no toggle has taken over. ThemeToggle plays a
		// change as a sky event (sunrise/sunset sweep) by cancelling the event;
		// without it, the theme just switches.
		const follow = () => {
			if (window.__themeOverride) return;
			const dark = defaultDark();
			if (dark === document.documentElement.classList.contains('theme-dark')) return;
			const event = new CustomEvent('theme:default', { detail: { dark }, cancelable: true });
			if (document.dispatchEvent(event)) document.documentElement.classList.toggle('theme-dark', dark);
		};
		darkDevice.addEventListener('change', follow);
		document.addEventListener('visibilitychange', () => document.hidden || follow());
		setInterval(follow, 60000);
	})();
</script>

<script is:inline>
	// Mark the page "animation-ready" BEFORE first paint so the CSS in base.css
	// hides entrance-animated elements up front — otherwise the fully-rendered
	// static HTML flashes for a frame before motion.ts sets its initial states.
	// Only added when JS runs and motion is allowed, so no-JS and reduced-motion
	// visitors always see fully-visible content. motion.ts then reveals it.
	const applyAnimReady = (root = document.documentElement) => {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		root.classList.toggle('anim-ready', !reduce);
	};
	applyAnimReady();
	if (!window.__animReadySwap) {
		window.__animReadySwap = true;
		document.addEventListener('astro:before-swap', (e) => {
			if (e.newDocument) applyAnimReady(e.newDocument.documentElement);
		});
		document.addEventListener('astro:after-swap', () => applyAnimReady());
		// Failsafe: if motion.ts never arrives (network error, blocked script),
		// don't leave pre-hidden content invisible — show it without motion.
		setTimeout(() => {
			if (!window.__motionReady) document.documentElement.classList.remove('anim-ready');
		}, 4000);
	}
</script>
