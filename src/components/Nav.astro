---
import Icon, { type Props as IconProps } from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	/** Hover over a full-screen page instead of sitting above it. */
	floating?: boolean;
	/**
	 * Stick to the top and let the page's hero name dock into the logo spot
	 * (the /lab Observatory prototype). The page drives `--dock-p` (0 → 1) on
	 * <body> and marks it [data-dock]; the "Timo3" text stays hidden until then.
	 */
	dockBrand?: boolean;
	/** Phones navigate from a bottom dock (MobileDock): no hamburger; the theme toggle moves up here. */
	mobileDock?: boolean;
	/** Show the command-palette trigger (⌘K) on desktop. */
	palette?: boolean;
}

const { floating = false, dockBrand = false, mobileDock = false, palette = false } = Astro.props;

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work/' },
	{ label: 'Photography', href: '/photography/' },
	/** { label: 'Blog', href: '/blog/' }, */
	{ label: 'About', href: '/about/' },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: IconProps['icon'] }[] = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/sean-timothy-navarro-842743247/', icon: 'linkedin-logo' },
	{ label: 'GitHub', href: 'https://github.com/STimothyDN', icon: 'github-logo' },
	{ label: 'Soundcloud', href:'https://soundcloud.com/timo_on_duty', icon: 'soundcloud-logo' },
	{ label: 'Instagram', href: 'https://www.instagram.com/timothy.rjs/', icon: 'instagram-logo' },
];
---

<nav class:list={{ 'is-floating': floating, 'is-docking': dockBrand, 'has-dock': mobileDock }}>
	<div class="menu-header">
		<a href="/" class="site-title">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
			<span class="site-title-text">Timo<span class="site-title-3">3</span></span>
		</a>
		{
			mobileDock ? (
				<div class="header-theme">
					<ThemeToggle />
				</div>
			) : (
				<menu-button>
					<template>
						<button class="menu-button" aria-expanded="false">
							<span class="sr-only">Menu</span>
							<Icon icon="list" />
						</button>
					</template>
				</menu-button>
			)
		}
	</div>
	<div id="menu-content">
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => {
					const active =
						Astro.url.pathname === href ||
						(href !== '/' && Astro.url.pathname.startsWith(href));
					return (
						<li>
							<a
								aria-current={Astro.url.pathname === href ? 'page' : undefined}
								class:list={['link', { active }]}
								href={href}
								transition:name={active ? 'nav-active-pill' : undefined}
							>
								{label}
							</a>
						</li>
					);
				})
			}
		</ul>
		<div class="menu-footer">
			{
				palette && (
					<button type="button" class="palette-trigger" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K">
						<Icon icon="magnifying-glass" />
						<span class="sr-only">Search</span>
						<kbd data-palette-shortcut aria-hidden="true">⌘K</kbd>
					</button>
				)
			}
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" target="_blank" rel="noopener">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		private readonly query = window.matchMedia('(min-width: 50em)');
		private readonly btn: HTMLButtonElement;
		private readonly menu: HTMLElement;

		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			this.btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			this.menu = document.getElementById('menu-content')!;
			this.menu.hidden = true;

			// Toggle menu visibility when the menu button is clicked.
			this.btn.addEventListener('click', () => this.setExpanded(this.menu.hidden));
		}

		/** Set whether the menu is currently expanded or collapsed. */
		private setExpanded(expand: boolean) {
			this.btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
			this.menu.hidden = !expand;
		}

		// Hide menu button for large screens.
		private handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
			this.setExpanded(e.matches);
			this.btn.hidden = e.matches;
		};

		connectedCallback() {
			this.handleViewports(this.query);
			this.query.addEventListener('change', this.handleViewports);
		}

		// ClientRouter replaces the nav on every navigation; release the query
		// listener with it, or every visited page's nav stays reachable.
		disconnectedCallback() {
			this.query.removeEventListener('change', this.handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
	}

	/* Full-screen pages: the nav hovers over the content (which supplies its
	   own scrim for legibility) and gives up its bottom margin. */
	nav.is-floating {
		position: fixed;
		inset: 0 0 auto;
		margin-bottom: 0;
	}

	.is-floating .menu-header {
		padding: 1rem 1.25rem;
	}

	/* Docking nav: sticks, and fades a scrim in behind itself as the page
	   scrolls under it (--dock-p comes from the page; 0 without one). */
	nav.is-docking {
		position: sticky;
		top: 0;
		/* The page scrolls under it, so it needs no gutter of its own. */
		margin-bottom: 1rem;
	}

	nav.is-docking::before {
		position: absolute;
		inset: 0 0 -2rem;
		content: '';
		background: linear-gradient(180deg, var(--gray-999) 40%, transparent);
		opacity: clamp(0, var(--dock-p, 1) * 2.5, 1);
		pointer-events: none;
		z-index: -1;
	}

	/* With the bottom dock, phones get no dropdown menu at all (the dock and
	   the command palette cover it); the theme toggle sits in the header. */
	.header-theme {
		display: flex;
		align-items: center;
	}

	@media (max-width: 49.99em) {
		nav.has-dock #menu-content {
			display: none;
		}
	}

	@media (min-width: 50em) {
		.header-theme {
			display: none;
		}
	}

	.palette-trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-right: 0.5rem;
		padding: 0.375rem 0.5rem 0.375rem 0.625rem;
		border: 1px solid color-mix(in oklch, var(--gray-0) 14%, transparent);
		border-radius: 999rem;
		background: var(--gray-999_65);
		font: inherit;
		font-size: var(--text-sm);
		color: var(--gray-300);
		cursor: pointer;
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.palette-trigger:hover,
	.palette-trigger:focus-visible {
		color: var(--gray-0);
		border-color: var(--link-color);
	}

	.palette-trigger kbd {
		padding: 0.1em 0.45em;
		border-radius: 0.3rem;
		background: color-mix(in oklch, var(--gray-0) 8%, transparent);
		font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.6875rem;
	}

	/* The hero's "3" is gradient ink; the docked logo matches it. */
	.is-docking .site-title-3 {
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	/* Handoff: the logo text appears only as the docking hero name arrives
	   (the last 4% of the dock), so the two never show at once. Keyed to
	   anim-ready (JS on, motion allowed — set before first paint) so the
	   logo is hidden from the first frame, and always shown without JS. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.anim-ready) .is-docking .site-title-text {
			opacity: clamp(0, (var(--dock-p, 1) - 0.96) * 25, 1);
		}
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0.5rem;
		font-size: 1.5rem;
		color: var(--gray-300);
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		box-shadow: var(--shadow-md);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background: linear-gradient(180deg, var(--gray-600), transparent),
			radial-gradient(var(--gray-900), var(--gray-800) 150%);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: var(--gradient-stroke);
		border-radius: 999rem;
		z-index: -1;
	}

	#menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
	}

	.link.active {
		color: var(--gray-0);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
		box-shadow: var(--shadow-lg);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-text-over);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 2.5rem 5rem;
			gap: 1rem;
		}

		.menu-header,
		.is-floating .menu-header {
			padding: 0;
		}

		nav.is-floating {
			padding: 1.25rem 2.5rem;
		}

		.site-title {
			font-size: var(--text-lg);
		}

		#menu-content {
			display: contents;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			font-size: var(--text-sm);
			border-radius: 999rem;
			border: 0;
			padding: 0.5rem 0.5625rem;
			background: var(--gray-999_65);
			-webkit-backdrop-filter: blur(12px);
			backdrop-filter: blur(12px);
			box-shadow: var(--shadow-md);
		}

		.nav-items::before {
			position: absolute;
			inset: -1px;
			content: '';
			background: var(--gradient-stroke);
			border-radius: 999rem;
			z-index: -1;
		}

		.link {
			padding: 0.5rem 1rem;
			border-radius: 999rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition),
				transform var(--theme-transition);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-100);
			background-color: var(--accent-subtle-overlay);
		}

		@media (prefers-reduced-motion: no-preference) {
			.link:hover {
				transform: translateY(-1px);
			}
		}

		.link.active {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}
	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
