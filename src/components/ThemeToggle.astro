---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button>
		<span class="sr-only">Dark theme</span>
		<span class="icon light"><Icon icon="sun" /></span>
		<span class="icon dark"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	button {
		display: inline-flex;
		flex-direction: row;
		border: 0;
		border-radius: 999rem;
		padding: 0;
		background-color: var(--gray-999);
		box-shadow: inset 0 0 0 1px var(--accent-overlay);
		cursor: pointer;
		line-height: 1;
	}

	.icon {
		z-index: 1;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		width: 2rem;
		height: 2rem;
		font-size: 1rem;
		/* Inactive icon: --accent-overlay was low-alpha (near-invisible in the
		 * photography light palette); gray-300 clears 3:1 in every theme. */
		color: var(--gray-300);
	}

	.icon :global(svg) {
		display: block;
	}

	.icon.light::before {
		content: '';
		z-index: -1;
		position: absolute;
		inset: 0;
		background-color: var(--accent-regular);
		border-radius: 999rem;
	}

	:global(.theme-dark) .icon.light::before {
		transform: translateX(100%);
	}

	:global(.theme-dark) .icon.dark,
	:global(html:not(.theme-dark)) .icon.light,
	button[aria-pressed='false'] .icon.light {
		color: var(--accent-text-over);
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon,
		.icon :global(svg),
		.icon.light::before {
			transition: transform 300ms cubic-bezier(0.33, 1, 0.68, 1), color var(--theme-transition);
		}

		/* The inactive icon rotates away as the pill slides */
		:global(.theme-dark) .icon.light :global(svg) {
			transform: rotate(-90deg) scale(0.8);
		}

		:global(html:not(.theme-dark)) .icon.dark :global(svg) {
			transform: rotate(90deg) scale(0.8);
		}
	}

	@media (forced-colors: active) {
		.icon.light::before {
			background-color: SelectedItem;
		}
	}
</style>

<script>
	import { skyLapse } from '../scripts/sky';

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	/**
	 * Observatory pages turn the switch into a sky event: a view transition
	 * where night falls from the top of the screen (dusk) or day rises from
	 * the horizon (dawn), a band of sunset/sunrise colour riding the edge.
	 * The new state is live, so the sky canvas swaps to stars or clouds under
	 * the sweep as it passes. On daylight pages the sky itself joins in: the
	 * day replays its morning up to now as it rises, or the stars come out,
	 * brightest first, as night falls. CSS: "7. THEME SWEEP" in transitions.css.
	 */
	function sweepTheme(dark: boolean, apply: () => void) {
		const canSweep =
			document.body.dataset.sky === 'observatory' && 'startViewTransition' in document && !reducedMotion.matches;
		if (!canSweep) return apply();

		const root = document.documentElement;
		const direction = dark ? 'dusk' : 'dawn';
		// Exists only in the new state, so the transition gets a lone, animatable
		// image of it; its band fades itself out before the transition ends.
		const glow = document.createElement('div');
		glow.className = 'theme-sweep-glow';
		glow.dataset.direction = direction;
		glow.append(document.createElement('span'));
		root.classList.add('theme-sweep', `theme-sweep-${direction}`);
		if ('daylight' in document.body.dataset) skyLapse(direction, dark ? 1.3 : 1.6);
		const transition = document.startViewTransition(() => {
			apply();
			document.body.append(glow);
		});
		transition.finished.finally(() => {
			glow.remove();
			root.classList.remove('theme-sweep', `theme-sweep-${direction}`);
		});
	}

	class ThemeToggle extends HTMLElement {
		private observer: MutationObserver | null = null;

		constructor() {
			super();

			const button = this.querySelector('button')!;

			/** Set the theme to dark/light mode. */
			const setTheme = (dark: boolean) => {
				sweepTheme(dark, () => {
					document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
					button.setAttribute('aria-pressed', String(dark));
				});
			};

			// Toggle the theme when a user clicks the button. This is the only place
			// the preference is persisted — an explicit choice, not a page-load state.
			// The photography section has its own storage key (see MainHead.astro),
			// so a toggle there never leaks into the rest of the site or vice versa.
			button.addEventListener('click', () => {
				const dark = !this.isDark();
				setTheme(dark);
				const isPhoto = window.location.pathname.startsWith('/photography');
				try {
					localStorage.setItem(isPhoto ? 'theme-photography' : 'theme', dark ? 'dark' : 'light');
				} catch {
					/* storage unavailable (private mode etc.) — theme still applies */
				}
			});

			// Initialize button state to reflect current theme (only the button —
			// setting the class here would save a theme the user never chose).
			// During a ClientRouter swap this constructor runs before `astro:after-swap`
			// reapplies `theme-dark` to the fresh <html>, so re-sync a frame later.
			const syncButton = () => button.setAttribute('aria-pressed', String(this.isDark()));
			syncButton();
			requestAnimationFrame(syncButton);
			// A page can carry more than one toggle (e.g. the mobile header's and
			// the menu's), and the command palette switches themes too: follow <html>.
			this.observer = new MutationObserver(syncButton);
		}

		connectedCallback() {
			this.observer?.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
		}

		disconnectedCallback() {
			this.observer?.disconnect();
		}

		isDark() {
			return document.documentElement.classList.contains('theme-dark');
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>
