---
/**
 * Phone navigation: a glass dock pinned to the bottom of the screen, in thumb
 * reach — the four sections plus search (opens the command palette, which
 * also carries the socials and actions). Replaces the top-corner hamburger
 * on pages that use it (Nav's `mobileDock`); hidden from 50em up, where the
 * top nav takes over.
 */
import Icon from './Icon.astro';
import type { Props as IconProps } from './Icon.astro';

const links: { label: string; href: string; icon: IconProps['icon'] }[] = [
	{ label: 'Home', href: '/', icon: 'house' },
	{ label: 'Work', href: '/work/', icon: 'code' },
	{ label: 'Photos', href: '/photography/', icon: 'camera' },
	{ label: 'About', href: '/about/', icon: 'user' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="mobile-dock" aria-label="Sections" data-glass data-glass-blur="6">
	<ul>
		{
			links.map(({ label, href, icon }) => (
				<li>
					<a href={href} class="dock-item" aria-current={isCurrent(href) ? 'page' : undefined}>
						<Icon icon={icon} size="1.35rem" />
						<span>{label}</span>
					</a>
				</li>
			))
		}
		<li class="divider" aria-hidden="true"></li>
		<li>
			<button type="button" class="dock-item" data-palette-open aria-haspopup="dialog">
				<Icon icon="magnifying-glass" size="1.35rem" />
				<span>Search</span>
			</button>
		</li>
	</ul>
</nav>

<style>
	.mobile-dock {
		position: fixed;
		left: 50%;
		bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
		z-index: 10002;
		translate: -50% 0;
		width: max-content;
		max-width: calc(100vw - 1.5rem);
		padding: 0.375rem;
		border: 1px solid color-mix(in oklch, var(--gray-0) 14%, transparent);
		border-radius: 1.5rem;
		background: color-mix(in oklch, var(--gray-999) 72%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		backdrop-filter: blur(16px) saturate(1.4);
		box-shadow: var(--shadow-lg);
	}

	ul {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.divider {
		width: 1px;
		height: 2rem;
		margin-inline: 0.25rem;
		background: color-mix(in oklch, var(--gray-0) 14%, transparent);
	}

	.dock-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		min-width: 3.75rem;
		padding: 0.45rem 0.5rem 0.4rem;
		border: 0;
		border-radius: 1.125rem;
		background: none;
		font: inherit;
		font-family: var(--font-brand);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1;
		color: var(--gray-300);
		text-decoration: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.dock-item:focus-visible {
		outline: 2px solid var(--link-color);
		outline-offset: 1px;
	}

	.dock-item[aria-current='page'] {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	@media (prefers-reduced-motion: no-preference) {
		.dock-item:active {
			scale: 0.94;
		}
	}

	/* Liquid glass (scripts/liquid-glass.ts) is on: thin the tint so the
	   refraction at the rim shows; labels stay over a soft blur. */
	:global(html.liquid-glass) .mobile-dock {
		background: color-mix(in oklch, var(--gray-999) 50%, transparent);
	}

	@media (min-width: 50em) {
		.mobile-dock {
			display: none;
		}
	}

	@media (forced-colors: active) {
		.dock-item[aria-current='page'] {
			color: SelectedItemText;
			background-color: SelectedItem;
		}
	}
</style>
