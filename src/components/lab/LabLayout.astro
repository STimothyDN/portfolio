---
/*
 * Frame for every Film Lab page. Lives inside the photography section's
 * editorial world (paper, ink, Fraunces/Newsreader) and borrows the edge print
 * found on film rebates for its labels. `door` pages (sign-in, setup, invite)
 * get a single centred column and no lab bar.
 */
import '@fontsource-variable/geist-mono';
import '@fontsource/permanent-marker/400.css';
import '../../styles/lab/index.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { labConfig } from '../../lib/lab/server/config';
import LabPalette from './LabPalette.vue';

interface Props {
	title: string;
	door?: boolean;
	/** Shooting mode: no site nav, footer or lab bar; the page draws its own. */
	shoot?: boolean;
	current?: 'home' | 'shoot' | 'rolls' | 'fridge' | 'gear' | 'labs' | 'account' | 'almanac';
	/** The bench and its close-ups: the page spends the full width on the mat. */
	wide?: boolean;
}

const { title, door = false, shoot = false, current, wide = false } = Astro.props;
const { user, labConfigured } = Astro.locals;
const config = labConfig();
const missing = config.ok ? [] : config.missing;
/*
 * Three places and a shutter button. The bench holds everything in motion
 * (its fridge, kit and post are close-ups of it), the binder everything
 * that's done, the almanac what it all adds up to. Icons are 24-unit line
 * drawings (stroke only).
 */
const place = current === 'home' || current === 'fridge' || current === 'gear' || current === 'labs' ? 'bench' : current === 'rolls' ? 'binder' : current;
const places = [
	['bench', 'Bench', '/photography/lab/', 'M2.5 15.5h19M4 15.5v4M20 15.5v4M6 15.5v-4.2h4.5v4.2M13 15.5V7.5h5.5v8'],
	['binder', 'Binder', '/photography/lab/rolls/', 'M6 3.5h12v17H6zM9 3.5v17M12 7.5h3.5M12 11h3.5'],
	['almanac', 'Almanac', '/photography/lab/almanac/', 'M3.5 20h17M6 20v-6M10 20V9M14 20v-8M18 20V5'],
] as const;
/*
 * A guest (signed out) looks round the owner's lab, live and read-only. The
 * margin explains what each place does and how to get a lab of your own.
 */
const guestOf = !user ? (Astro.locals.guest ?? null) : null;
const owner = guestOf?.name.split(/\s+/)[0] ?? '';
const here = Astro.url.pathname;
const signIn = `/photography/lab/sign-in/?next=${encodeURIComponent(here)}`;
const invite = 'mailto:timothyrjs@gmail.com?subject=' + encodeURIComponent('A Film Lab of my own');
const onRoll = /^\/photography\/lab\/rolls\/[^/]+\/?$/.test(here);
const GUIDE: Record<string, { name: string; text: string[] }> = {
	home: {
		name: 'The bench',
		text: [
			'Every roll in motion, laid out the way film travels: out of the fridge, into a camera, shot, off to a lab, back as scans on the light table, then filed in the binder.',
			'In your own lab you drag a roll to where it goes next and it travels there (every move can be undone). The Today card ranks what needs doing; press A to number everything and read its details.',
		],
	},
	fridge: { name: 'The fridge', text: ['Unshot film, shelf by shelf, oldest dates first: how many of each, when they expire, and how long they’ll last at the rate they get loaded.'] },
	gear: { name: 'The kit', text: ['Every camera with its battery and service history, what’s loaded in it, and the lenses grouped by the mount they fit.'] },
	labs: { name: 'The post', text: ['Film waiting to be sent, envelopes at a lab with how long that lab usually takes, and the labs used.'] },
	rolls: onRoll
		? { name: 'A roll', text: ['One roll as a sleeve of negatives: where it’s been and when, what it yielded and cost, how dense its negatives came back against the same film elsewhere, and every scan in strips of six. Tap a frame to look closer.'] }
		: { name: 'The binder', text: ['Every roll as a line through time: along its camera’s lane while loaded, then waiting, at a lab, scans in, filed. Drag across the line to pick a stretch of time; the sleeves below follow.'] },
	frames: { name: 'The frames', text: ['Every frame logged on the phone (aperture, shutter, time) as one dot. Re-arrange them by exposure, by light against how dense the negative came back, by hour, or roll by roll.'] },
	almanac: { name: 'The almanac', text: ['What it all adds up to, in nine chapters: where film waits, which cameras give thin negatives, whether the film speed suits the light, keepers, rhythm, kit, labs, money and shelf life.'] },
};
const guide = GUIDE[current ?? 'home'] ?? GUIDE.home;

const initials = (user?.name ?? '')
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((part) => part[0]?.toUpperCase())
	.join('');
---

<BaseLayout title={`${title} · Film Lab`} description="A private film logbook." noindex bare={shoot}>
	<Fragment slot="head">
		{/* Installable as its own app (Add to Home Screen), opening on shooting mode. */}
		<link rel="manifest" href="/photography/lab/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/photography/lab/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Film Lab" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="theme-color" content="#000000" />
		{/* Who's signed in, for queueing moves made with no signal (src/lib/lab/offline.ts). */}
		{user && <meta name="lab-user" content={user.id} />}
	</Fragment>
	<div class:list={['lab', { 'lab--wide': wide }]} data-lab>
		{
			!labConfigured ? (
				<main class="lab-door">
					<p class="lab-edge">Film Lab</p>
					<h1 class="lab-title">Not set up here yet</h1>
					<p class="lab-lede">
						This deployment is missing the settings Film Lab needs: {missing.join(', ')}. Add them in the
						Vercel project's environment variables and redeploy.
					</p>
				</main>
			) : door ? (
				<main class="lab-door">
					{/* Over the darkroom door: the lamp that says someone's working inside. */}
					<div class="lab-sign" aria-hidden="true">
						<span class="lab-sign-glass">
							<b>Darkroom</b>
							<i>In use · keep the door shut</i>
						</span>
					</div>
					<slot />
				</main>
			) : shoot ? (
				<>
					<div class="lab-progress" aria-hidden="true"></div>
					<main class="lab-shoot">
						<slot />
					</main>
				</>
			) : (
				<>
					<header class="lab-bar lab-wrap">
						<a class="lab-wordmark" href="/photography/lab/">
							Film Lab
						</a>
						<span class="lab-bar-print" aria-hidden="true">
							Timo3 · Private · Safety film
						</span>
						{guestOf ? (
							<a class="lab-me lab-me--guest" href={signIn}>
								<span class="lab-me-label">Sign in</span>
								<span class="lab-avatar" aria-hidden="true">
									→
								</span>
							</a>
						) : (
							<a class="lab-me" href="/photography/lab/account/" aria-current={current === 'account' ? 'page' : undefined}>
								<span class="lab-me-label">Account</span>
								<span class="lab-avatar" aria-hidden="true">
									{initials || '·'}
								</span>
							</a>
						)}
					</header>
					{guestOf && (
						/* Narrower screens: a strip along the top that stays in view; open it for how this place works. */
						<details class="lab-guide-strip lab-wrap">
							<summary>
								<span class="lab-guide-eye">
									<b>{owner}’s Film Lab</b>, live and read-only
								</span>
								<span class="lab-guide-more">How it works</span>
							</summary>
							<div class="lab-guide-body">
								<p class="lab-guide-name">{guide.name}</p>
								{guide.text.map((t) => (
									<p>{t}</p>
								))}
								<p class="lab-guide-cta">
									Want one of your own? Film Lab is invite-only for now: <a href={invite}>ask for an invite</a> and you get a lab of your own, empty and ready. Have one? <a href={signIn}>Sign in</a>.
								</p>
							</div>
						</details>
					)}
					{/* The dock: a strip of film, one frame per place, the shutter release in the middle. */}
					<nav class="lab-dock" aria-label="Film Lab" transition:name="lab-nav">
						{places.slice(0, 2).map(([key, label, href, icon]) => (
							<a href={href} aria-current={place === key ? 'page' : undefined}>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d={icon} />
								</svg>
								<span>{label}</span>
							</a>
						))}
						<a class="lab-shutter" href={guestOf ? signIn : '/photography/lab/shoot/'} title={guestOf ? 'Shooting mode: sign in to your own lab' : 'Shoot: log frames as you go'}>
							<span class="sr-only">Shoot</span>
						</a>
						{places.slice(2).map(([key, label, href, icon]) => (
							<a href={href} aria-current={place === key ? 'page' : undefined}>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d={icon} />
								</svg>
								<span>{label}</span>
							</a>
						))}
						<button type="button" class="lab-find" data-lab-find aria-keyshortcuts="Meta+K Control+K /">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="10.5" cy="10.5" r="6" />
								<path d="m15 15 5 5" />
							</svg>
							<span>Find</span>
							<kbd>⌘K</kbd>
						</button>
					</nav>
					<LabPalette client:idle guest={!!guestOf} />
					<div class="lab-progress" aria-hidden="true"></div>
					{guestOf ? (
						<div class="lab-guest">
							<main class="lab-main lab-wrap">
								<slot />
							</main>
							{/* Wide screens: the margin, always in view. */}
							<aside class="lab-guide" aria-label="About this lab">
								<p class="lab-guide-eye">
									<b>{owner}’s Film Lab</b>
									<span>Live · read-only</span>
								</p>
								<p class="lab-guide-name">{guide.name}</p>
								{guide.text.map((t) => (
									<p>{t}</p>
								))}
								<p class="lab-guide-note">On a phone, shooting mode logs each frame as it’s taken (aperture, shutter, time, roughly where), with no signal if need be. Where frames were taken, tracking and order numbers stay private here.</p>
								<div class="lab-guide-cta">
									<p>
										<b>A lab of your own</b>
										Every account gets its own lab, empty and ready for your cameras and film. It’s invite-only for now.
									</p>
									<a class="lab-btn" href={invite}>
										Ask for an invite
									</a>
									<a class="lab-link" href={signIn}>
										I have one: sign in
									</a>
								</div>
							</aside>
						</div>
					) : (
						<main class="lab-main lab-wrap">
							<slot />
						</main>
					)}
				</>
			)
		}
	</div>
</BaseLayout>

<script>
	// The service worker keeps lab pages (shooting mode above all) working with
	// no signal. Scoped to /photography/lab/, so the public site never sees it.
	if ('serviceWorker' in navigator && location.protocol !== 'file:') {
		navigator.serviceWorker.register('/photography/lab/sw.js', { scope: '/photography/lab/' }).catch(() => {});
		// With signal, keep the bench and shooting mode (and everything they load) saved on
		// this device, so the whole shooting workflow opens in the woods. Once a visit.
		const saveForOffline = () => {
			try {
				if (!navigator.onLine || !document.querySelector('meta[name="lab-user"]') || sessionStorage.getItem('lab-offline-saved')) return;
				navigator.serviceWorker.ready.then((reg) => {
					reg.active?.postMessage({ type: 'save-for-offline', pages: ['/photography/lab/shoot/', '/photography/lab/'] });
					sessionStorage.setItem('lab-offline-saved', '1');
				});
			} catch {
				// Private mode: pages still save as they're opened.
			}
		};
		saveForOffline();
		window.addEventListener('online', () => {
			try {
				sessionStorage.removeItem('lab-offline-saved');
			} catch {}
			saveForOffline();
		});
	}

	/*
	 * Feeling fast. A finger landing on a lab link (or a pointer resting on one)
	 * asks the service worker to start fetching that page, so by the time the
	 * tap completes it's usually there. And every navigation shows at once that
	 * it heard you: the link dims and a strip of film winds across the top.
	 */
	const isLabLink = (el: EventTarget | null): HTMLAnchorElement | null => {
		const a = (el as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
		if (!a || a.target === '_blank' || a.hasAttribute('download')) return null;
		// SVG links (the binder's line) keep their href as an attribute, not a string property.
		const url = new URL(a.getAttribute('href') ?? '', location.href);
		if (url.origin !== location.origin || !url.pathname.startsWith('/photography/lab/')) return null;
		if (url.pathname === location.pathname && url.search === location.search) return null;
		return a;
	};
	const asked = new Map<string, number>();
	function warm(a: HTMLAnchorElement) {
		if (!navigator.serviceWorker?.controller) return; // nowhere to keep it
		const url = new URL(a.getAttribute('href') ?? '', location.href);
		const key = url.pathname + url.search;
		if (Date.now() - (asked.get(key) ?? 0) < 12000) return;
		asked.set(key, Date.now());
		fetch(key, { headers: { 'X-Lab-Prefetch': '1' }, credentials: 'same-origin' }).catch(() => {});
	}
	document.addEventListener(
		'pointerdown',
		(e) => {
			const a = isLabLink(e.target);
			if (a && e.button === 0) warm(a);
		},
		{ capture: true, passive: true }
	);
	let hover: ReturnType<typeof setTimeout> | undefined;
	document.addEventListener(
		'pointerover',
		(e) => {
			if (e.pointerType !== 'mouse') return;
			const a = isLabLink(e.target);
			clearTimeout(hover);
			if (a) hover = setTimeout(() => warm(a), 90);
		},
		{ passive: true }
	);
	document.addEventListener('pointerout', () => clearTimeout(hover), { passive: true });

	const root = document.documentElement;
	let safety: ReturnType<typeof setTimeout> | undefined;
	const busy = (on: boolean) => {
		root.classList.toggle('lab-navigating', on);
		clearTimeout(safety);
		if (on) safety = setTimeout(() => busy(false), 12000);
		else document.querySelectorAll('.lab-pending').forEach((el) => el.classList.remove('lab-pending'));
	};
	/*
	 * Moving between stations winds the film: the page you're on slides out
	 * through the gate as the next frame slides in, in the strip nav's order.
	 * Into a roll from the list (and back out) the table lifts toward you
	 * instead, like a negative raised to the loupe. The header, the lab bar and
	 * the strip hold still (they're named for the transition only while it runs).
	 */
	// The bench and its close-ups are one place; the binder and its rolls another.
	const STATION: Record<string, number> = { '': 0, fridge: 0, gear: 0, labs: 0, labels: 0.5, rolls: 1, r: 1, frames: 1, almanac: 2, account: 3, shoot: -1 };
	const BENCH = new Set(['', 'fridge', 'gear', 'labs']);
	const stationOf = (url: URL) => {
		if (!url.pathname.startsWith('/photography/lab')) return null;
		const parts = url.pathname.replace(/^\/photography\/lab\/?/, '').split('/').filter(Boolean);
		const head = parts[0] ?? '';
		// The doors (sign-in, setup, invite) aren't stations.
		return head in STATION ? { head, at: STATION[head], depth: parts.length } : null;
	};
	const turnFor = (from: URL, to: URL) => {
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return null;
		const a = stationOf(from);
		const b = stationOf(to);
		if (!a || !b) return null;
		// Bench to a close-up and back: the station grows to fill the mat (or shrinks back into it).
		if (BENCH.has(a.head) && BENCH.has(b.head) && a.head !== b.head) return 'zone';
		if (b.at !== a.at) return b.at > a.at ? 'next' : 'prev';
		if (b.depth !== a.depth) return b.depth > a.depth ? 'in' : 'out';
		return null;
	};
	let turnDone: ReturnType<typeof setTimeout> | undefined;
	const endTurn = () => {
		clearTimeout(turnDone);
		delete root.dataset.labTurn;
	};

	document.addEventListener('astro:before-preparation', (e) => {
		const ev = e as Event & { from: URL; to: URL; sourceElement?: Element };
		endTurn();
		if (!ev.to.pathname.startsWith('/photography/lab')) return;
		const turn = turnFor(ev.from, ev.to);
		if (turn) root.dataset.labTurn = turn;
		ev.sourceElement?.classList.add('lab-pending');
		busy(true);
	});
	// The router copies the incoming page's <html> attributes over: carry the turn
	// across so the new frame is named too, and clear it once the film has moved.
	document.addEventListener('astro:before-swap', (e) => {
		const ev = e as Event & { newDocument?: Document; viewTransition?: { finished: Promise<void> } };
		const turn = root.dataset.labTurn;
		if (!turn || !ev.newDocument) return;
		ev.newDocument.documentElement.dataset.labTurn = turn;
		ev.viewTransition?.finished.finally(endTurn);
		turnDone = setTimeout(endTurn, 1500);
	});
	// Full page loads (links the router leaves alone) get the same signal.
	document.addEventListener('click', (e) => {
		const a = isLabLink(e.target);
		if (a && !e.defaultPrevented && !e.metaKey && !e.ctrlKey && !e.shiftKey && a.hasAttribute('data-astro-reload')) busy(true);
	});
	// The dock's Find button opens the ⌘K finder (LabPalette listens).
	document.addEventListener('click', (e) => {
		if ((e.target as Element | null)?.closest?.('[data-lab-find]')) dispatchEvent(new Event('lab:palette'));
	});
	document.addEventListener('astro:after-swap', () => busy(false));
	document.addEventListener('astro:page-load', () => busy(false));
	window.addEventListener('pageshow', () => busy(false));
</script>
