---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** Full-screen page (the film desk): the nav floats over it and there's no footer. */
	immersive?: boolean;
	/** Sticky nav whose logo the page's hero name docks into (see Nav.astro). */
	dockBrand?: boolean;
	/** Keep the page out of search results (prototypes under /lab). */
	noindex?: boolean;
	/*
	 * The Observatory chrome is the default everywhere outside photography
	 * (which keeps its own editorial world); each piece can be turned off.
	 */
	/** Sky tier: the interactive real sky (src/scripts/sky), or the plain random field. */
	sky?: 'observatory' | 'plain';
	/** Meteor pace on observatory pages: 'calm' (~20/min) suits long reads. */
	skyPace?: 'lively' | 'calm';
	/**
	 * Daylight observatory (light mode on observatory pages): the GPU
	 * atmosphere, the real Sun and Moon, live RTP weather (clouds, rain on the
	 * glass), sun-cast shadows and the sunrise/stars-out theme switch — plus,
	 * on the home page, the weather-station readout, the sun-path Fig. 1 and
	 * the tree-line horizon.
	 */
	daylight?: boolean;
	/** Phones get the bottom nav dock instead of the hamburger menu. */
	mobileDock?: boolean;
	/** Mount the command palette (⌘K) and its desktop nav trigger. */
	palette?: boolean;
}

// Which "world" is this page in? The photography section gets the editorial
// theme (see tokens.css `html[data-section="photography"]`). Computed server-side
// so the correct theme is applied on direct load / no-JS, and travels with each
// route's HTML across ClientRouter swaps.
const path = Astro.url.pathname;
const section =
	path === '/photography' || path.startsWith('/photography/') ? 'photography' : 'default';
const mainSite = section !== 'photography';

const {
	title,
	description,
	immersive = false,
	dockBrand = false,
	noindex = false,
	sky = mainSite ? 'observatory' : 'plain',
	skyPace = 'lively',
	daylight = mainSite,
	mobileDock = mainSite,
	palette = mainSite,
} = Astro.props;
const observatory = sky === 'observatory';
---

<html lang="en" data-section={section}>
	<head>
		<MainHead title={title} description={description} noindex={noindex} />
	</head>
	<body
		data-sky={observatory ? 'observatory' : undefined}
		data-sky-pace={observatory && skyPace === 'calm' ? 'calm' : undefined}
		data-daylight={observatory && daylight ? '' : undefined}
	>
		{/*
			The canvas renders ambient sky effects: clouds in light mode and
			stars/meteors in dark mode (src/scripts/sky, drawn off the main thread
			where supported). Page content is wrapped in .content so it appears
			above. Persisted across ClientRouter swaps: the sky carries over between
			pages, and its control is handed to the drawing worker only once.
		*/}
		<div class="stack backgrounds">
			{/* GPU star layer (observatory pages; src/scripts/sky/glsky.ts), under the 2D sky. */}
			<canvas class="sky-gl" transition:persist="sky-gl"></canvas>
			<canvas class="twinkling-stars" transition:persist="sky"></canvas>
			<div class:list={['content', { 'has-mobile-dock': mobileDock }]}>
				<Nav floating={immersive} dockBrand={dockBrand} mobileDock={mobileDock} palette={palette} />
				<slot />
				{!immersive && <Footer />}
			</div>
			{mobileDock && <MobileDock />}
			{palette && <CommandPalette />}
		</div>

		<!--
			Section-transition persistence anchors. Empty shells whose only job is to
			let Astro's ClientRouter carry the live (animating) overlays built by
			section-transition.ts across the swap: an element with a matching
			data-astro-transition-persist id must exist in the incoming page. The
			script owns all inner markup and rebuilds it on demand — keeping children
			here would just be a second copy to drift out of sync.
		-->
		<div class="flash-transition" aria-hidden="true" data-astro-transition-persist="flash-overlay"></div>
		<div class="dslr-shutdown__blackout" aria-hidden="true" data-astro-transition-persist="dslr-blackout"></div>
		<div class="dslr-shutdown" aria-hidden="true" data-astro-transition-persist="dslr-modal"></div>
		<div class="dslr-shutdown__crt" aria-hidden="true" data-astro-transition-persist="dslr-crt"></div>

		<script>
			import '../scripts/photo-section-snap';
			import '../scripts/section-transition';
			import '../scripts/sky';
			import '../scripts/motion';
			// Observatory chrome; switches itself off outside observatory pages.
			import '../scripts/liquid-glass';
			// Daylight observatory: loaded on demand, only on daylight pages (not photography)
			// (each module starts itself on load, then follows the swaps).
			let daylightLoaded = false;
			const syncDaylight = () => {
				if (!daylightLoaded && 'daylight' in document.body.dataset) {
					daylightLoaded = true;
					void import('../scripts/sky/weather');
					void import('../scripts/sun-shadows');
					void import('../scripts/rain-glass');
					void import('../scripts/sun-path');
				}
			};
			syncDaylight();
			document.addEventListener('astro:after-swap', syncDaylight);
		</script>

		<style>
			/* --- Atmosphere --- */
			/* The sky is now fully procedural: a per-palette OKLCH gradient mesh
			   (--bg-mesh in tokens.css) under the film-grain noise tile, with the
			   canvas painting stars/clouds above. No more JPEG background stack. */
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				position: relative;
				background:
					/*noise*/ url('/assets/backgrounds/noise.png') top center/220px repeat,
					/*mesh*/ var(--bg-mesh, none),
					/*base*/ var(--gray-999);
				/* --bg-mesh expands to four gradient layers; blend-mode lists repeat
				   cyclically, so pad with explicit normals to keep overlay on the
				   noise tile only. */
				background-blend-mode: overlay, normal, normal, normal, normal;
			}

			/* Editorial theme: clean paper (--bg-mesh is none there, but keep the
			   hard override so the noise tile also disappears). */
			html[data-section='photography'] .backgrounds {
				background: var(--gray-999);
				background-blend-mode: normal;
			}

			/* --- Canvas Styles for Stars & Meteors --- */
			.sky-gl,
			.twinkling-stars {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100vh;
				height: 100lvh;
				pointer-events: none;
				z-index: 1;
				transition: opacity 600ms ease;
			}

			/* Stars fade out in the editorial world; the renderer pauses there too. */
			html[data-section='photography'] .sky-gl,
			html[data-section='photography'] .twinkling-stars {
				opacity: 0;
			}

			/* Ensure main content appears above the canvas */
			.content {
				position: relative;
				z-index: 2;
			}

			/* Room under the footer for the bottom dock. */
			@media (max-width: 49.99em) {
				.content.has-mobile-dock {
					padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
				}
			}

			@media (forced-colors: active) {
				.backgrounds {
					background: none;
					background-blend-mode: none;
					--bg-gradient-size: none;
				}
			}
		</style>
	</body>
</html>
