---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="404 Error — this page was not found">
	<div class="wrapper lost stack gap-8">
		<p class="code" aria-hidden="true">
			<span class="glyph">4</span><span class="glyph">0</span><span class="glyph">4</span>
		</p>
		<Hero title="Page Not Found" tagline="Not found" />
	</div>
</BaseLayout>

<style>
	.lost {
		padding-block: 4rem 8rem;
		text-align: center;
	}

	.code {
		font-family: var(--font-brand);
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1;
		color: var(--gray-0);
		display: flex;
		justify-content: center;
		gap: 0.05em;
	}

	.glyph {
		display: inline-block;
		will-change: transform;
	}
</style>

<script>
	import { FollowGroup } from '../scripts/follow';
	import { spawnMeteor } from '../scripts/sky';

	// The 404 glyphs shy away from the cursor — decorative, fine pointers only.
	function setup() {
		const code = document.querySelector<HTMLElement>('.lost .code');
		if (!code) return;
		// A lost page deserves a shooting star (dark mode only; no-ops elsewhere).
		setTimeout(spawnMeteor, 600);
		if (!window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;

		const glyphs = Array.from(code.querySelectorAll<HTMLElement>('.glyph')).map((el) => {
			const group = new FollowGroup(() => (el.style.translate = `${x.current}px ${y.current}px`));
			const x = group.value(0, 0.6, 'power3.out');
			const y = group.value(0, 0.6, 'power3.out');
			return { el, group, x, y };
		});

		// Document-level listener: released on the next ClientRouter swap.
		const ac = new AbortController();
		document.addEventListener(
			'astro:before-swap',
			() => {
				ac.abort();
				glyphs.forEach((g) => g.group.halt());
			},
			{ once: true }
		);
		document.addEventListener(
			'pointermove',
			(e) => {
				for (const g of glyphs) {
					const r = g.el.getBoundingClientRect();
					const dx = r.x + r.width / 2 - e.clientX;
					const dy = r.y + r.height / 2 - e.clientY;
					const dist = Math.hypot(dx, dy);
					const radius = 220;
					if (dist < radius && dist > 0) {
						const push = (1 - dist / radius) * 48;
						g.x.to((dx / dist) * push);
						g.y.to((dy / dist) * push);
					} else {
						g.x.to(0);
						g.y.to(0);
					}
				}
			},
			{ signal: ac.signal }
		);
	}

	document.addEventListener('astro:page-load', setup);
</script>
