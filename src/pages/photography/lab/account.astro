---
import LabAccount from '../../../components/lab/LabAccount.vue';
import LabLayout from '../../../components/lab/LabLayout.astro';
import { labConfig } from '../../../lib/lab/server/config';
import { listInvites, listPasskeys, remainingRecoveryCodes } from '../../../lib/lab/server/plugin';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const owner = user?.role === 'owner';
const [passkeys, recoveryRemaining, invites] =
	user && config.ok
		? await Promise.all([
				listPasskeys(config.config, user.id),
				remainingRecoveryCodes(config.config, user.id),
				owner ? listInvites(config.config, user.id) : Promise.resolve(null),
			])
		: [[], 0, null];
const recovered = Astro.url.searchParams.has('recovered');
---

<LabLayout title="Account" current="account">
	{
		user && (
			<>
				<section class="lab-hello">
					<span class="lab-edge">Account</span>
					<h1 class="lab-title">{user.name}</h1>
					<p class="lab-meta lab-mono">
						{user.email} · {owner ? 'owner' : 'member'}
					</p>
				</section>
				<LabAccount
					client:load
					passkeys={passkeys}
					recoveryRemaining={recoveryRemaining}
					invites={invites}
					recovered={recovered}
				/>
			</>
		)
	}
</LabLayout>

<style>
	.lab-hello {
		display: grid;
		gap: 0.6rem;
	}
</style>
