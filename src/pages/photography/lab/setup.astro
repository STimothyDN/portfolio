---
import LabClaim from '../../../components/lab/LabClaim.vue';
import LabLayout from '../../../components/lab/LabLayout.astro';
import { labConfig } from '../../../lib/lab/server/config';
import { setupOpen } from '../../../lib/lab/server/plugin';

export const prerender = false;

const config = labConfig();
const open = config.ok ? await setupOpen(config.config) : false;
---

<LabLayout title="Set up" door>
	<span class="lab-edge">First-time setup</span>
	<h1 class="lab-title">Set up Film Lab</h1>
	{
		open ? (
			<>
				<p class="lab-lede">
					Create the owner account with the setup code from the deployment’s settings, then save a passkey
					on this device.
				</p>
				<div class="lab-sprockets" aria-hidden="true" />
				<LabClaim client:load kind="setup" />
			</>
		) : (
			<>
				<p class="lab-lede">Film Lab is already set up, or this deployment has no setup code.</p>
				<p>
					<a class="lab-btn" href="/photography/lab/sign-in/">
						Sign in
					</a>
				</p>
			</>
		)
	}
</LabLayout>
