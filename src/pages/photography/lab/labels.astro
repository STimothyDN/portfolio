---
/*
 * Printable QR stickers. Each one carries the roll code (to write on nothing:
 * it's printed) and a QR code for /photography/lab/r/<code>, which the phone's
 * own camera opens: shooting mode if the roll is loaded, else its page.
 */
import QRCode from 'qrcode';

import LabLayout from '../../../components/lab/LabLayout.astro';
import { pushPull, STATUS_LABEL } from '../../../lib/lab/inventory';
import { labConfig } from '../../../lib/lab/server/config';
import { getDb } from '../../../lib/lab/server/db/client';
import { rollViews } from '../../../lib/lab/server/inventory';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const picked = new Set(Astro.url.searchParams.getAll('code').map((c) => c.toUpperCase()));
const size = Astro.url.searchParams.get('size') === 'back' ? 'back' : 'canister';

const data =
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const all = await rollViews(d, user.id);
				// Offer rolls that are still physical canisters in play.
				const offer = all
					.filter((r) => r.status === 'storage' || r.status === 'camera' || r.status === 'shot')
					.sort((a, b) => a.code.localeCompare(b.code));
				const chosen = picked.size ? offer.filter((r) => picked.has(r.code)) : offer.filter((r) => r.status !== 'shot');
				const labels = await Promise.all(
					chosen.map(async (r) => ({
						roll: r,
						qr: await QRCode.toString(`${Astro.url.origin}/photography/lab/r/${r.code}`, {
							type: 'svg',
							margin: 0,
							errorCorrectionLevel: 'M',
							color: { dark: '#000000', light: '#ffffff' },
						}),
					}))
				);
				return { offer, labels, chosenCodes: new Set(chosen.map((r) => r.code)) };
			})()
		: null;
---

<LabLayout title="Labels" current="rolls">
	{
		data && (
			<>
				<section class="lab-head no-print">
					<div>
						<span class="lab-edge">Print</span>
						<h1 class="lab-title">Roll labels</h1>
					</div>
					<p class="lab-meta">Scan one with your phone’s camera to open that roll, or shooting mode if it’s loaded.</p>
				</section>

				<form class="pick no-print" method="get">
					<fieldset>
						<legend>Rolls</legend>
						<div class="codes">
							{data.offer.map((r) => (
								<label>
									<input type="checkbox" name="code" value={r.code} checked={data.chosenCodes.has(r.code)} />
									<span class="lab-code">{r.code}</span>
									<span class="lab-meta">
										{r.stock.name} · {STATUS_LABEL[r.status].toLowerCase()}
									</span>
								</label>
							))}
						</div>
					</fieldset>
					<fieldset>
						<legend>Size</legend>
						<label>
							<input type="radio" name="size" value="canister" checked={size === 'canister'} /> Canister (2 × 0.75 in)
						</label>
						<label>
							<input type="radio" name="size" value="back" checked={size === 'back'} /> Camera back (2.25 × 1.1 in)
						</label>
					</fieldset>
					<div class="lab-actions">
						<button type="submit" class="lab-btn lab-btn--quiet">Update sheet</button>
						<button type="button" class="lab-btn" data-print>
							Print {data.labels.length} {data.labels.length === 1 ? 'label' : 'labels'}
						</button>
					</div>
				</form>

				{data.labels.length ? (
					<div class:list={['sheet', size]}>
						{data.labels.map(({ roll, qr }) => (
							<div class="label">
								<div class="qr" set:html={qr} />
								<div class="text">
									<span class="code">{roll.code}</span>
									<span class="stock">{roll.stock.name}</span>
									{size === 'back' && (
										<span class="meta">
											{[
												roll.shotAtIso ? `ISO ${roll.shotAtIso}` : roll.stock.iso ? `ISO ${roll.stock.iso}` : null,
												pushPull(roll.stock.iso, roll.shotAtIso),
												`${roll.exposures} exp`,
												roll.stock.process,
											]
												.filter(Boolean)
												.join(' · ')}
										</span>
									)}
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="lab-empty no-print">Pick some rolls above.</p>
				)}
			</>
		)
	}
</LabLayout>

<script>
	document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
	.pick {
		display: grid;
		gap: 1.25rem;
	}

	fieldset {
		display: grid;
		gap: 0.5rem;
		padding: 0;
		border: 0;
	}

	legend {
		margin-bottom: 0.5rem;
		font-family: var(--font-brand);
		font-size: var(--text-md);
		font-weight: 560;
		color: var(--gray-0);
	}

	.codes {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 0.4rem 1.25rem;
	}

	.codes label,
	fieldset > label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	input[type='checkbox'],
	input[type='radio'] {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--accent-regular);
	}

	/* The sheet: real sizes, black on white whatever the theme. */
	.sheet {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15in;
		padding: 0.3in;
		border-radius: 6px;
		background: #fff;
		color: #000;
	}

	.label {
		display: flex;
		align-items: center;
		gap: 0.08in;
		width: 2in;
		height: 0.75in;
		padding: 0.06in 0.08in;
		border: 1px dashed #bbb;
		border-radius: 0.06in;
		overflow: hidden;
	}

	.back .label {
		width: 2.25in;
		height: 1.1in;
	}

	.qr {
		flex: none;
		width: 0.6in;
		height: 0.6in;
	}

	.back .qr {
		width: 0.9in;
		height: 0.9in;
	}

	.qr :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.text {
		display: grid;
		gap: 0.02in;
		min-width: 0;
	}

	.code {
		font-family: 'Permanent Marker', 'Marker Felt', cursive;
		font-size: 15pt;
		line-height: 1;
	}

	.stock {
		font-family: var(--font-body);
		font-size: 7.5pt;
		line-height: 1.15;
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 6pt;
	}

	@media print {
		:global(html[data-section='photography'] body *) {
			visibility: hidden;
		}

		.sheet,
		.sheet * {
			visibility: visible;
		}

		.sheet {
			position: absolute;
			inset: 0 0 auto;
			padding: 0.4in;
			border-radius: 0;
		}

		.label {
			border-color: #ddd;
		}
	}
</style>
