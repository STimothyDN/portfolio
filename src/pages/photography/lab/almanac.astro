---
/**
 * The almanac: what your film adds up to, findings first, then nine chapters.
 * Read-only and drawn on the server; see AlmanacPage.vue and server/almanac.ts.
 */
import LabLayout from '../../../components/lab/LabLayout.astro';
import AlmanacPage from '../../../components/lab/almanac/AlmanacPage.vue';
import { labConfig } from '../../../lib/lab/server/config';
import { almanacData } from '../../../lib/lab/server/almanac';
import { viewerOf, visible } from '../../../lib/lab/server/guest';

export const prerender = false;

// Signed out, a guest sees the owner's lab, read-only and with private details taken out.
const { user, guest } = viewerOf(Astro.locals);
const config = labConfig();
const data = user && config.ok ? visible(await almanacData(config.config, user), guest) : null;
---

<LabLayout title="Almanac" current="almanac">
	{
		data && (
			<>
				<section class="lab-head">
					<div>
						<span class="lab-edge">What your film adds up to</span>
						<h1 class="lab-title">The almanac</h1>
					</div>
				</section>
				<AlmanacPage client:visible data={data} />
			</>
		)
	}
</LabLayout>
