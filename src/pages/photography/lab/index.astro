---
import ImportDesk from '../../../components/lab/ImportDesk.vue';
import LabLayout from '../../../components/lab/LabLayout.astro';
import LightTable from '../../../components/lab/LightTable.vue';
import { formatDay, todayInDurham } from '../../../lib/lab/inventory';
import { isOwner, labConfig } from '../../../lib/lab/server/config';
import { getDb } from '../../../lib/lab/server/db/client';
import { labSettings, labStats, rollViews, stepChoices } from '../../../lib/lab/server/inventory';
import { rewind } from '../../../lib/lab/server/rewind';
import { listPasskeys } from '../../../lib/lab/server/plugin';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const today = todayInDurham();

const data =
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const [all, choices, stats, passkeys, settings] = await Promise.all([
					rollViews(d, user.id),
					stepChoices(d, user.id, isOwner(user)),
					labStats(d, user.id),
					listPasskeys(config.config, user.id),
					labSettings(d, user.id),
				]);
				const negatives = all
					.filter((r) => r.status === 'negatives')
					.sort((a, b) => b.statusOn.localeCompare(a.statusOn) || b.code.localeCompare(a.code));
				return {
					active: all.filter((r) => r.status !== 'negatives' && r.status !== 'lost'),
					negatives,
					total: all.length,
					choices,
					stats,
					passkeys: passkeys.length,
					binderHints: [...new Set(all.map((r) => r.negativesAt).filter((v): v is string => !!v))].slice(0, 12),
					shareLoaded: isOwner(user) ? settings.shareLoaded : null,
					rewind: isOwner(user) && all.length ? await rewind(all, today) : null,
				};
			})()
		: null;
const firstName = user?.name.split(/\s+/)[0] ?? '';
---

<LabLayout title="Light table" current="home">
	{
		data && (
			<>
				<section class="lab-hello">
					<span class="lab-edge">Light table</span>
					<h1 class="lab-title">Hello, {firstName}.</h1>
					{data.total === 0 &&
						(data.choices.deskRolls.length > 0 ? (
							<>
								<p class="lab-lede">
									Your logbook is empty. Start with the {data.choices.deskRolls.length} rolls already on the film
									desk: each becomes a roll here, filed under “Negatives home” and linked to its scans, and
									the cameras, film stocks and labs they name come along too.
								</p>
								<ImportDesk client:load count={data.choices.deskRolls.length} />
							</>
						) : (
							<p class="lab-lede">
								Your logbook is empty. Add your cameras on the <a class="lab-link" href="/photography/lab/gear/">Gear</a> page and
								the film you have on hand in the <a class="lab-link" href="/photography/lab/fridge/">fridge</a>, and every roll gets a
								code to follow from the fridge to the negative binder.
							</p>
						))}
				</section>

				{data.passkeys < 2 && (
					<aside class="lab-notice lab-nudge">
						<p>
							You have {data.passkeys === 1 ? 'one passkey' : 'no passkeys'}. Add one from your other device
							too, so losing a phone never locks you out.
						</p>
						<a class="lab-btn lab-btn--quiet" href="/photography/lab/account/">
							Manage passkeys
						</a>
					</aside>
				)}

				<LightTable
					client:load
					rolls={data.active}
					negativesCount={data.negatives.length}
					recentNegatives={data.negatives.slice(0, 3)}
					choices={data.choices}
					labStats={data.stats}
					binderHints={data.binderHints}
					today={today}
					shareLoaded={data.shareLoaded}
				/>

				{data.rewind && (
					<section class="lab-section rewind" aria-labelledby="rewind-h">
						<header class="rewind-head">
							<span class="lab-edge">Rewind · {data.rewind.when}</span>
							<h2 id="rewind-h" class="lab-h2">{data.rewind.title}</h2>
							<p class="lab-meta">
								Developed {formatDay(data.rewind.developed)} · {data.rewind.count} scans
								{data.rewind.code && (
									<>
										{' · '}
										<a class="lab-code" href={`/photography/lab/rolls/${data.rewind.code}/`}>{data.rewind.code}</a>
									</>
								)}
							</p>
						</header>
						<ul class="rewind-prints">
							{data.rewind.scans.map((s, i) => (
								<li style={`--i:${i}`}>
									<img src={s.src} width={s.w} height={s.h} alt="" loading="lazy" decoding="async" />
								</li>
							))}
						</ul>
					</section>
				)}
			</>
		)
	}
</LabLayout>

<style>
	.lab-hello {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.lab-nudge {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.lab-nudge p {
		flex: 1 1 20rem;
	}

	/* A few prints from the archive, dropped on the table. */
	.rewind {
		display: grid;
		gap: 1rem;
	}

	.rewind-head {
		display: grid;
		gap: 0.35rem;
	}

	.rewind-prints {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
		gap: 1rem;
		list-style: none;
		padding: 0.5rem 0.25rem;
	}

	.rewind-prints li {
		padding: 0.45rem 0.45rem 1.4rem;
		background: oklch(98% 0.006 85);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 10px 24px -14px rgb(0 0 0 / 0.4);
		rotate: calc((var(--i) - 1.5) * 1.6deg);
	}

	.rewind-prints img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}
</style>
