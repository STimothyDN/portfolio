---
/**
 * The bench: everything in motion on one surface, laid out as a roll's loop
 * (fridge → cameras → shot → post → light table → binder). See BenchWorld.vue.
 */
import LabLayout from '../../../components/lab/LabLayout.astro';
import BenchWorld from '../../../components/lab/bench/BenchWorld.vue';
import { todayInDurham } from '../../../lib/lab/inventory';
import { labConfig } from '../../../lib/lab/server/config';
import { benchData } from '../../../lib/lab/server/bench';
import { viewerOf, visible } from '../../../lib/lab/server/guest';

export const prerender = false;

// Signed out, a guest sees the owner's lab, read-only and with private details taken out.
const { user, guest } = viewerOf(Astro.locals);
const config = labConfig();
const data = user && config.ok ? visible(await benchData(config.config, user, todayInDurham()), guest) : null;
const move = guest ? null : Astro.url.searchParams.get('move');
---

<LabLayout title="Bench" current="home" wide>
	{/* The bench settles in station by station the first time it's opened in a visit. */}
	<script is:inline>
		try {
			if (!sessionStorage.getItem('lab-bench')) {
				sessionStorage.setItem('lab-bench', '1');
				document.documentElement.classList.add('lab-bench-enter');
				setTimeout(() => document.documentElement.classList.remove('lab-bench-enter'), 2400);
			}
		} catch {}
	</script>
	{data && <BenchWorld client:load data={data} firstName={user?.name.split(/\s+/)[0]} move={move} readOnly={guest} />}
</LabLayout>
