---
import FridgeShelves from '../../../components/lab/FridgeShelves.vue';
import LabLayout from '../../../components/lab/LabLayout.astro';
import BenchCloseup from '../../../components/lab/bench/BenchCloseup.astro';
import { stageCounts } from '../../../lib/lab/server/bench';
import { getFilmLabels } from '../../../utils/film';
import { todayInDurham } from '../../../lib/lab/inventory';
import { isOwner, labConfig } from '../../../lib/lab/server/config';
import { getDb } from '../../../lib/lab/server/db/client';
import { labelGaps, listCameras, listLabs, listStocks, rollMilestones, rollViews, stepChoices } from '../../../lib/lab/server/inventory';
import { restockForecast } from '../../../lib/lab/pace';
import { viewerOf, visible } from '../../../lib/lab/server/guest';

export const prerender = false;

// Signed out, a guest sees the owner's lab, read-only and with private details taken out.
const { user, guest } = viewerOf(Astro.locals);
const config = labConfig();
// The mini-map's counts, read alongside the page's own data.
const countsP = user && config.ok ? stageCounts(config.config, user.id) : Promise.resolve({});
// The film desk's names (from Film Labs), for the owner's "on the desk, not in the logbook yet".
const labels = user && isOwner(user) ? await getFilmLabels() : { cameras: {}, stocks: {}, labs: {}, brands: {} };
const data = visible(
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const [rolls, stocks, choices, cameras, labs, milestones] = await Promise.all([
					rollViews(d, user.id),
					listStocks(d, user.id),
					stepChoices(d, user.id, isOwner(user)),
					listCameras(d, user.id),
					listLabs(d, user.id),
					rollMilestones(d, user.id),
				]);
				const totals: Record<string, number> = {};
				for (const r of rolls) totals[r.stock.id] = (totals[r.stock.id] ?? 0) + 1;
				const storage = rolls.filter((r) => r.status === 'storage');
				// Only the owner's logbook follows the film desk's labels.
				const gaps = isOwner(user) ? labelGaps(labels, { stocks, cameras, labs }) : { stocks: [], cameras: [], labs: [] };
				// How fast each stock leaves the fridge, from when rolls went into cameras.
				const forecast = restockForecast(
					rolls,
					Object.fromEntries(rolls.map((r) => [r.id, milestones[r.id]?.camera])),
					todayInDurham()
				);
				return {
					forecast,
					storage,
					stocks,
					totals,
					choices,
					shops: [...new Set(rolls.map((r) => r.purchasedFrom).filter((v): v is string => !!v))].sort(),
					// Names on the film desk the logbook doesn't have yet (new labels, like CineStill 800T).
					deskNames: [
						...gaps.stocks.map((t) => (labels.stocks as Record<string, string>)[t]),
						...gaps.cameras.map((t) => (labels.cameras as Record<string, string>)[t]),
						...gaps.labs.map((t) => (labels.labs as Record<string, string>)[t]),
					],
				};
			})()
		: null,
	guest
);
const counts = await countsP;
---

<LabLayout title="Fridge" current="fridge" wide>
	{
		data && (
			<BenchCloseup zone="fridge" counts={counts} title="The fridge" lede="Unshot film, oldest dates in front. Drag a canister onto a camera on the bench to load it.">
				<FridgeShelves
					client:load
					readOnly={guest}
					storage={data.storage}
					stocks={data.stocks}
					totals={data.totals}
					choices={data.choices}
					shops={data.shops}
					deskNames={data.deskNames}
					forecast={data.forecast}
					today={todayInDurham()}
				/>
			</BenchCloseup>
		)
	}
</LabLayout>
