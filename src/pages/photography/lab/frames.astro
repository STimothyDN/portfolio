---
import FramesDesk from '../../../components/lab/FramesDesk.vue';
import LabLayout from '../../../components/lab/LabLayout.astro';
import RollsTabs from '../../../components/lab/RollsTabs.astro';
import { isOwner, labConfig } from '../../../lib/lab/server/config';
import { getDb } from '../../../lib/lab/server/db/client';
import { framesPage } from '../../../lib/lab/server/frames';
import { viewerOf, visible } from '../../../lib/lab/server/guest';

export const prerender = false;

// Signed out, a guest sees the owner's lab, read-only and with private details taken out.
const { user, guest } = viewerOf(Astro.locals);
const config = labConfig();
const data = user && config.ok ? visible(await framesPage(await getDb(config.config), user.id, isOwner(user)), guest) : null;
const q = Astro.url.searchParams.get('q') ?? '';
---

<LabLayout title="Frames" current="rolls" wide>
	{
		data && (
			<>
				<section class="lab-head">
					<div>
						<span class="lab-edge">Rolls</span>
						<h1 class="lab-title">Frames</h1>
						<p class="lab-edge-print">Every frame you’ve logged · ask the field a question · search · map</p>
					</div>
					<RollsTabs current="frames" />
				</section>
				<FramesDesk client:load rows={data.rows} rolls={data.rolls} initialQuery={q} />
				<p class="lab-meta">
					How the negatives come back, camera by camera and lab by lab, is in the <a class="lab-link" href="/photography/lab/almanac/#exposure">almanac</a>.
				</p>
			</>
		)
	}
</LabLayout>
