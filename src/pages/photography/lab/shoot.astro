---
import LabLayout from '../../../components/lab/LabLayout.astro';
import ShootMode from '../../../components/lab/ShootMode.vue';
import { todayInDurham } from '../../../lib/lab/inventory';
import { isOwner, labConfig } from '../../../lib/lab/server/config';
import { deskTone } from '../../../lib/lab/server/frames';
import { formatExpiry } from '../../../lib/lab/inventory';
import { rollPace } from '../../../lib/lab/pace';
import { getFilmRolls } from '../../../utils/film';
import { getDb } from '../../../lib/lab/server/db/client';
import { listCameras, listFrames, listLenses, rollViews } from '../../../lib/lab/server/inventory';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const data =
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const [all, cameras, lenses] = await Promise.all([rollViews(d, user.id), listCameras(d, user.id), listLenses(d, user.id)]);
				const loaded = all.filter((r) => r.status === 'camera');
				const today = todayInDurham();
				// The owner's scans say how each camera's negatives tend to come back (on the same film).
				const tone = isOwner(user) ? deskTone(await getFilmRolls()) : null;
				const liftOf = new Map((tone?.cameras ?? []).filter((g) => g.compared >= 20 && g.lift != null).map((g) => [g.key, g.lift!]));
				const tokenOf = new Map(cameras.map((c) => [c.id, c.token]));
				const preflight = Object.fromEntries(
					loaded.map((r) => {
						const pace = rollPace(r, today);
						const lift = r.camera ? liftOf.get(tokenOf.get(r.camera.id) ?? '') : undefined;
						const left = r.exposures - r.frameCount;
						const hint =
							lift != null && lift >= 0.025
								? 'This camera’s negatives come back thin: give shade and dim light a stop more.'
								: lift != null && lift <= -0.02
									? 'This camera exposes generously: it copes well with dim light.'
									: left <= 3 && r.frameCount > 0
										? 'Last few frames: finish on something you love.'
										: null;
						return [r.id, { pace: pace ? `${pace.rate} · ${pace.finish}` : null, hint, lift: lift ?? null }];
					})
				);
				// What to load next: the oldest-dated rolls in the fridge.
				const nextUp = all
					.filter((r) => r.status === 'storage')
					.sort((a, b) => (a.expires ?? '9999').localeCompare(b.expires ?? '9999') || a.code.localeCompare(b.code))
					.slice(0, 3)
					.map((r) => ({ code: r.code, stock: r.stock.name, expires: r.expires ? formatExpiry(r.expires) : null }));
				return {
					rolls: loaded,
					cameras: Object.fromEntries(
						cameras.map((c) => [c.id, { name: c.name, kind: c.kind, mount: c.mount, fixedLens: c.fixedLens, format: c.format, status: c.status }])
					),
					lenses: lenses.filter((l) => l.status !== 'gone' && l.status !== 'wishlist'),
					frames: await listFrames(d, user.id, loaded.map((r) => r.id)),
					spots: [...new Set(all.map((r) => r.storageSpot).filter((v): v is string => !!v))].sort(),
					preflight,
					nextUp,
					// The fridge too: with no signal, a roll can still be loaded here (it syncs later).
					fridge: all.filter((r) => r.status === 'storage'),
				};
			})()
		: null;
---

<LabLayout title="Shoot" shoot current="shoot">
	{
		data && user && (
			<ShootMode
				client:load
				userId={user.id}
				rolls={data.rolls}
				cameras={data.cameras}
				lenses={data.lenses}
				frames={data.frames}
				initialCode={Astro.url.searchParams.get('roll')}
				spots={data.spots}
				preflight={data.preflight}
				nextUp={data.nextUp}
				fridge={data.fridge}
				today={todayInDurham()}
			/>
		)
	}
</LabLayout>

<style is:global>
	/* Safelight reaches the edges of the screen, not just the column. */
	html[data-safelight],
	html[data-safelight] body,
	html[data-safelight] .backgrounds {
		background: #000 !important;
	}
</style>
