---
import LabLayout from '../../../components/lab/LabLayout.astro';
import BenchCloseup from '../../../components/lab/bench/BenchCloseup.astro';
import TripPlanner from '../../../components/lab/trip/TripPlanner.vue';
import { todayInDurham } from '../../../lib/lab/inventory';
import { stageCounts } from '../../../lib/lab/server/bench';
import { labConfig } from '../../../lib/lab/server/config';
import { listTrips } from '../../../lib/lab/server/darkroom';
import { getDb } from '../../../lib/lab/server/db/client';
import { allFrames, listBatteryStock, listCameras, rollViews } from '../../../lib/lab/server/inventory';
import { framesPerDay } from '../../../lib/lab/trip';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const countsP = user && config.ok ? stageCounts(config.config, user.id) : Promise.resolve({});
const data =
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const [rolls, cameras, batteries, frames, trips] = await Promise.all([rollViews(d, user.id), listCameras(d, user.id), listBatteryStock(d, user.id), allFrames(d, user.id), listTrips(d, user.id)]);
				return {
					fridge: rolls.filter((r) => r.status === 'storage'),
					loaded: rolls.filter((r) => r.status === 'camera'),
					cameras: cameras.filter((c) => c.status === 'active' || c.status === 'shelf'),
					batteries,
					perDay: framesPerDay(frames),
					trips,
				};
			})()
		: null;
const counts = await countsP;
---

<LabLayout title="Trip planner" current="trip" wide>
	{
		data && (
			<BenchCloseup zone="fridge" counts={counts} title="Trip planner" lede="Where and when, which cameras: how much film to bring, which speeds the forecast asks for, and what to check before you go.">
				<TripPlanner client:load {...data} today={todayInDurham()} />
			</BenchCloseup>
		)
	}
</LabLayout>
