---
import LabLayout from '../../../../components/lab/LabLayout.astro';
import RollDetail from '../../../../components/lab/RollDetail.vue';
import RollFrames from '../../../../components/lab/RollFrames.vue';
import { todayInDurham } from '../../../../lib/lab/inventory';
import { labConfig } from '../../../../lib/lab/server/config';
import { getDb } from '../../../../lib/lab/server/db/client';
import {
	deskRollPreview,
	listCameras,
	listFrames,
	listLenses,
	listStocks,
	rollByCode,
	rollViews,
	stepChoices,
} from '../../../../lib/lab/server/inventory';
import { bunnyUrl } from '../../../../utils/bunny';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const code = (Astro.params.code ?? '').toUpperCase();

const data =
	user && config.ok
		? await (async () => {
				const d = await getDb(config.config);
				const found = await rollByCode(d, user.id, code);
				if (!found) return null;
				const [choices, stocks, cameras, all, preview, frames, lenses] = await Promise.all([
					stepChoices(d, user.id),
					listStocks(d, user.id),
					listCameras(d, user.id),
					rollViews(d, user.id),
					found.roll.publicRollId ? deskRollPreview(found.roll.publicRollId) : Promise.resolve(null),
					listFrames(d, user.id, [found.roll.id]),
					listLenses(d, user.id),
				]);
				// Lenses that fit the roll's camera (plus any its frames already name).
				const mount = cameras.find((c) => c.id === found.roll.camera?.id)?.mount?.trim().toLowerCase();
				const used = new Set(frames.map((f) => f.lensId));
				return {
					...found,
					choices,
					stocks,
					cameras: cameras.map((c) => ({ id: c.id, name: c.name })),
					frames,
					lenses: lenses.filter((l) => used.has(l.id) || (mount && l.mount.trim().toLowerCase() === mount)),
					binderHints: [...new Set(all.map((r) => r.negativesAt).filter((v): v is string => !!v))].slice(0, 12),
					desk: preview && {
						id: preview.id,
						title: preview.title,
						developed: preview.developed,
						count: preview.count,
						scans: preview.scans.map((s) => ({
							src: bunnyUrl(s.path, { width: 360, format: 'webp', quality: 72 }),
							frame: s.frame,
							w: s.w,
							h: s.h,
						})),
					},
				};
			})()
		: null;
if (user && config.ok && !data) Astro.response.status = 404;
---

<LabLayout title={data ? data.roll.code : 'Roll not found'} current="rolls">
	{
		data ? (
			<>
			<RollDetail
				client:load
				roll={data.roll}
				events={data.events}
				choices={data.choices}
				stocks={data.stocks}
				allCameras={data.cameras}
				desk={data.desk}
				binderHints={data.binderHints}
				today={todayInDurham()}
			/>
			<RollFrames
				client:load
				rollId={data.roll.id}
				code={data.roll.code}
				exposures={data.roll.exposures}
				inCamera={data.roll.status === 'camera'}
				cameraId={data.roll.camera?.id ?? null}
				rewoundAtFrame={data.roll.rewoundAtFrame}
				frames={data.frames}
				lenses={data.lenses}
			/>
			</>
		) : (
			user && (
				<section class="lab-hello">
					<span class="lab-edge">Rolls</span>
					<h1 class="lab-title">No roll {code}</h1>
					<p class="lab-lede">
						It isn’t in your logbook. <a href="/photography/lab/rolls/">See every roll</a>.
					</p>
				</section>
			)
		)
	}
</LabLayout>
