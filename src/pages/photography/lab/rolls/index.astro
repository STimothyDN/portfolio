---
/**
 * The binder: every roll on one time line, then a sleeve page for each.
 * See BinderPage.vue.
 */
import LabLayout from '../../../../components/lab/LabLayout.astro';
import RollsTabs from '../../../../components/lab/RollsTabs.astro';
import BinderPage from '../../../../components/lab/binder/BinderPage.vue';
import { labConfig } from '../../../../lib/lab/server/config';
import { binderData } from '../../../../lib/lab/server/binder';

export const prerender = false;

const { user } = Astro.locals;
const config = labConfig();
const data = user && config.ok ? await binderData(config.config, user) : null;
const status = Astro.url.searchParams.get('status');
---

<LabLayout title="Binder" current="rolls" wide>
	{
		data && (
			<>
				<section class="lab-head">
					<div>
						<span class="lab-edge">Everything that’s been round the bench</span>
						<h1 class="lab-title">The binder</h1>
					</div>
					<RollsTabs current="rolls" />
				</section>
				<BinderPage client:load data={data} initialStatus={status} />
			</>
		)
	}
</LabLayout>
