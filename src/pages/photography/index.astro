---
import BaseLayout from '../../layouts/BaseLayout.astro';

import MediumToggle from '../../components/MediumToggle.astro';
import FilmDesk from '../../components/film/FilmDesk.vue';
import { packFilmPhotos } from '../../components/film/data';
import { bunnyUrl } from '../../utils/bunny';
import { getFilmDesk, rollFolder, toFilmDeskData } from '../../utils/film';
import { publishedExposures, publishedLoaded, publishedMarks } from '../../utils/published';

// The whole desk comes from Film Labs. A production build without it fails on purpose,
// so the live site keeps its last good desk instead of going blank.
const filmDesk = await getFilmDesk();
if (!filmDesk.ok && import.meta.env.PROD) {
	throw new Error('The film desk couldn’t be read from Film Labs (FILM_LAB_API_URL). Not building an empty desk.');
}
const rolls = filmDesk.rolls;
// Exposure, lens and place, for rolls the owner chose to share; and their marks.
const published = await publishedExposures();
const marks = await publishedMarks();
const desk = toFilmDeskData(rolls, published, marks);
// What's in the cameras right now, if the owner shows it.
const loadedNow = await publishedLoaded();

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
	title="Photography | Timothy Navarro"
	description="Every film scan Timothy Navarro has, tossed onto one desk — sort them by camera, film stock, lab, year, or roll."
	immersive
>
	{/*
		Inline on purpose: if this page contributed any rules to the bundled CSS,
		its stylesheet would differ from the FilmDesk island's own CSS chunk and
		Astro would link both — shipping the whole desk stylesheet twice. Kept
		out of the bundle, the two chunks are identical and collapse into one.
		The desk needs JavaScript; without it, the <noscript> contact sheets
		stand in (the scripting: none rule).
	*/}
	<style is:inline>
		.film-page .film-empty {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.5rem;
			min-height: 100svh;
			padding: 6rem 1.5rem;
			font-size: var(--text-lg);
			font-style: italic;
			color: var(--gray-300);
			text-align: center;
		}

		@media (scripting: none) {
			.film-page .film {
				display: none;
			}
		}

		.film-page .film-static {
			padding-block: 8rem 4rem;
		}

		.film-page .film-static section + section {
			margin-top: 3rem;
		}

		.film-page .film-static h2 {
			font-size: var(--text-2xl);
		}

		.film-page .film-static-meta {
			margin-top: 0.25rem;
			font-size: var(--text-sm);
			letter-spacing: 0.06em;
			font-variant-caps: all-small-caps;
			color: var(--gray-300);
		}

		.film-page .film-static-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
			gap: 1rem;
			margin-top: 1.25rem;
		}

		.film-page .film-static-grid img {
			width: 100%;
			height: auto;
		}
	</style>

	<!-- The whole page is the desk: rolls float along the top, controls along
	     the bottom, and the site nav hovers over both. -->
	<div class="film-page">
		<h1 class="sr-only">Film photography by Timothy Navarro</h1>
		{
			rolls.length > 0 ? (
				<>
					<FilmDesk client:load rolls={desk.rolls} packedPhotos={packFilmPhotos(desk.photos)} {...(loadedNow.length ? { loadedNow } : {})}>
						<MediumToggle current="film" variant="dock" />
					</FilmDesk>
					<noscript>
						<div class="film-static wrapper">
							{rolls.map((roll) => (
								<section>
									<h2>{roll.data.title}</h2>
									<p class="film-static-meta">Developed {formatDate(roll.data.developed)}</p>
									<div class="film-static-grid">
										{roll.data.photos.map((photo) => (
											<img
												src={bunnyUrl(`${rollFolder(roll)}/${photo.filename}`, {
													width: 480,
													format: 'webp',
													quality: 72,
												})}
												alt={photo.caption ?? ''}
												width={photo.width}
												height={photo.height}
												loading="lazy"
												decoding="async"
											/>
										))}
									</div>
								</section>
							))}
						</div>
					</noscript>
				</>
			) : (
				<div class="film-empty">
					<p>The scans are still at the lab. Check back soon.</p>
					<MediumToggle current="film" />
				</div>
			)
		}
	</div>
</BaseLayout>
